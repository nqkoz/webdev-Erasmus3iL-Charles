# Copy to .env for local use. Real values belong in your hosting provider's settings, never in git.
PORT=3000
# Required. Copy the PostgreSQL connection string from Neon (or your local PostgreSQL service).
DATABASE_URL=postgresql://user:password@host/dbname
# Optional. Use the public HTTPS address when Google sign-in is enabled outside localhost.
PUBLIC_BASE_URL=http://localhost:3000

# Optional. Copy both values from the Google Cloud OAuth client; callback URI:
# http://localhost:3000/auth/google/callback locally, or <PUBLIC_BASE_URL>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Copy a Gemini API key from Google AI Studio; suggestions fall back without it.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
MODEL_NAME=gemini-2.5-flash

# Only required when launching the Lab Booking MCP server. Copy the current lab_session cookie
# value locally; it expires after seven days and must never be committed or pasted into chat.
MCP_TOKEN=

# Optional pair for a local demo account. Set both values; the password must be at least 8 characters.
SEED_STUDENT_EMAIL=student@lab-booking.local
SEED_STUDENT_PASSWORD=

# Set by the runtime. In production, NODE_ENV=production enables Secure session cookies.
NODE_ENV=development
