# Every environment variable your app needs, with harmless placeholder values.
# Copy to .env for local use. Real values go into your hosting provider's settings, never into git.
# In a codespace, put the secret ones in the repository's Codespaces secrets instead of a file.
PORT=3000
DATABASE_URL=postgres://user:password@host/dbname
SESSION_SECRET=change-me
PUBLIC_BASE_URL=http://localhost:3000

# Sign in with Google. Create an OAuth client at console.cloud.google.com and leave it in
# "Testing" mode with yourself as a test user: that is free and needs no app verification.
# Register each callback URI in Google Cloud: http://localhost:3000/auth/google/callback
# for local use, and https://<your-host>/auth/google/callback for each deployed host.
# Google requires https off localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The model feature. A free key comes from aistudio.google.com; any provider is fine,
# and so is a model that runs locally, as long as the app still works without it.
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# The current lab_session cookie value for the Lab Booking MCP server.
# It expires after seven days; keep the replacement only in your ignored local .env file.
# The MCP tools enforce that account's permissions through the same services as HTTP.
MCP_TOKEN=

# Local Exercise 2 demo account. Set a private value in your ignored .env file.
SEED_STUDENT_EMAIL=student@lab-booking.local
SEED_STUDENT_PASSWORD=
