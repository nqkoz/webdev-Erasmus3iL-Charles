{
  "name": "webdev-erasmus3il",
  "version": "1.0.0",
  "description": "This repository is your workspace for the whole course: Exercise 1 in `mcp-server/`, and your project (Exercises 2–5) in the rest of it. Everything runs in your browser through GitHub Codespaces, so nothing needs to be installed on your laptop.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test && node mcp-server/check.mjs -- node mcp-server/server.js",
    "coverage": "npm run coverage:services && node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=80",
    "coverage:services": "node --test --experimental-test-coverage --test-coverage-include=src/services/** --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100",
    "mcp": "node mcp-server/server.js",
    "mcp:lab-booking": "node --env-file-if-exists=.env mcp-server/labBookingServer.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nqkoz/webdev-Erasmus3iL-Charles.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nqkoz/webdev-Erasmus3iL-Charles/issues"
  },
  "homepage": "https://github.com/nqkoz/webdev-Erasmus3iL-Charles#readme",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17"
  }
}
